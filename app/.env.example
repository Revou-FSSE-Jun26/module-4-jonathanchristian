# Copy this file to app/.env and replace every placeholder. Never commit app/.env.
# The placeholders below are not real credentials.

# SQLAlchemy URI of the development database
DATABASE_URL=postgresql+psycopg2://kano_user:change-me@localhost:5432/kano

# Signing secret for access and refresh tokens (use a long random value)
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Token lifetimes in seconds (positive integers)
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=604800

# Comma-separated list of allowed browser origins, no trailing slash
CORS_ORIGINS=http://localhost:3000

# pytest only. Must differ from DATABASE_URL and the database name must end with _test
TEST_DATABASE_URL=postgresql+psycopg2://kano_user:change-me@localhost:5432/kano_test

# NOTE (deployment risk): the local venv uses Python 3.14. A psycopg2-binary wheel for
# Python 3.14 may not exist on every platform, and the Vercel Python runtime may not offer
# 3.14. Verify before deploying. Fallback: pin a supported runtime (for example with a
# .python-version file) or switch the driver (psycopg2 from source, or psycopg[binary]).
